{
  "name": "@krion/viewer-chat",
  "version": "1.0.0",
  "description": "Autodesk Viewer + AI Chat interface widget for controlling 3D models through natural language",
  "main": "dist/viewer-chat.umd.js",
  "module": "dist/viewer-chat.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/viewer-chat.esm.js",
      "require": "./dist/viewer-chat.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./styles": "./dist/viewer-chat.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "autodesk",
    "viewer",
    "forge",
    "aps",
    "chat",
    "ai",
    "3d",
    "bim",
    "construction"
  ],
  "author": "Krion",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.9.6",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.1.0",
    "rimraf": "^5.0.5",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {},
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krion/viewer-chat.git"
  }
}
