# ACC Dashboard Multi-Agent System - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Select your LLM provider: anthropic, openai, or google/gemini
LLM_PROVIDER=anthropic

# API Keys - Only the key for your selected provider is required
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIza...

# Optional: Override the default model
# For Anthropic: claude-sonnet-4-20250514, claude-3-haiku-20240307, etc.
# For OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, etc.
# For Google: gemini-1.5-pro, gemini-1.5-flash, etc.
# LLM_MODEL=claude-sonnet-4-20250514

# =============================================================================
# Application Settings
# =============================================================================

# Enable debug mode (auto-reload on file changes)
DEBUG=false

# Server port
PORT=8000

# Data directory containing Excel files
DATA_DIRECTORY=data

# =============================================================================
# Cache Configuration
# =============================================================================

# Cache type: memory or redis
CACHE_TYPE=memory

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# For memory cache: maximum number of entries
CACHE_MAX_SIZE=1000

# For Redis cache (only needed if CACHE_TYPE=redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# =============================================================================
# ACC (Autodesk Construction Cloud) OAuth Configuration
# =============================================================================

# APS (Autodesk Platform Services) App credentials for 3-legged OAuth
APS_CLIENT_ID=your_aps_client_id
APS_CLIENT_SECRET=your_aps_client_secret
APS_CALLBACK_URL=http://localhost:8000/api/acc/callback

# =============================================================================
# JWT Authentication (must match ti-backend ACCESS_TOKEN_SECRET)
# =============================================================================

ACCESS_TOKEN_SECRET=your_access_token_secret

# =============================================================================
# Optional Settings
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
